# Binance 环境：mainnet 为正式网，testnet 为合约测试网；切换后 REST 与 WebSocket 一起切换。
BINANCE_ENV=mainnet

# 分别填写正式网和测试网 API 凭证。切换 BINANCE_ENV 时会自动选择对应凭证。
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 旧配置名仅作为正式网凭证的兼容回退，不用于测试网。
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# 只有明确设置为 true 时，后端才允许提交订单。
TRADING_ENABLED=false
PORT=8788

# 可选：自定义 Binance REST / WebSocket 地址。通常只需切换 BINANCE_ENV。
# BINANCE_FUTURES_BASE_URL=
# BINANCE_FUTURES_WS_URL=

# 可选：生产环境建议只允许这个前端来源访问后端。
APP_ORIGIN=http://localhost:5173

# 可选：Node 后端访问 Binance 使用的 HTTPS 代理；Windows 会自动读取系统代理。
# HTTPS_PROXY=http://127.0.0.1:2080

# OpenAI 兼容接口配置。可以填写官方地址，也可以填写中转服务的 /v1 地址。
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# AI 请求最长等待时间（毫秒），推理模型响应较慢时可适当增大，默认 120000。
# OPENAI_TIMEOUT_MS=120000
# AI 单次回复最大输出 token 数，默认 900；兼容 OpenAI 的 chat/completions 接口。
# OPENAI_MAX_TOKENS=900

# 本地 LightGBM/ONNX 预测服务默认开启；仅设置 false 才会关闭。预测结果由 AI 解释层说明，不会自动下单。
PREDICTION_ENABLED=true
# PREDICTION_SERVICE_URL=http://127.0.0.1:8790/predict
# PREDICTION_TIMEOUT_MS=10000
# 模型训练和本地预测服务默认配置
# 训练子进程使用的 Python；Windows 下使用 pythonw 可以隐藏训练终端窗口。
# Linux/macOS 可删除这一行，让程序自动选择虚拟环境中的 Python。
# PREDICTION_PYTHON=.venv/Scripts/pythonw.exe
# 模型文件和历史 K 线数据的保存目录。
PREDICTION_MODEL_DIR=prediction/models
PREDICTION_DATA_DIR=data
# 自动重训练默认使用的单个币种和周期；网页训练以当前选中币种为准。
# PREDICTION_SYMBOL=BTCUSDT
# PREDICTION_INTERVAL=1h
# 采集历史 K 线的起始时间（Unix 毫秒时间戳）。
PREDICTION_START_TIME=1704067200000
# 每个样本向前预测的 K 线根数，以及候选模型最低测试样本数。
PREDICTION_HORIZON_BARS=3
PREDICTION_MIN_TEST_SAMPLES=500
# K 线采集遇到临时网络错误时的重试次数。
PREDICTION_COLLECT_RETRIES=3
# 训练任务状态和日志文件。
PREDICTION_TRAINING_STATE_FILE=prediction/validation/training-state.json
PREDICTION_TRAINING_LOG_FILE=prediction/validation/training.log
# 前向验证数据库目录和数据保留天数。
PREDICTION_VALIDATION_DIR=prediction/validation
PREDICTION_VALIDATION_RETENTION_DAYS=90
# 本地预测服务监听地址；后端通过 PREDICTION_SERVICE_URL 调用它。
PREDICTION_HOST=127.0.0.1
PREDICTION_PORT=8790
